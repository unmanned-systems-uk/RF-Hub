{
  "name": "rf-hub-smoke-tests",
  "version": "1.0.0",
  "description": "Playwright smoke test suite for RF-Hub",
  "scripts": {
    "test": "playwright test && node generate-report.js",
    "test:phone": "playwright test --project=phone",
    "test:desktop": "playwright test --project=desktop",
    "test:headed": "playwright test --headed",
    "report": "node generate-report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  }
}
